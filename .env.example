# Salin file ini menjadi .env.local lalu isi dengan data proyek Supabase kamu
# (Supabase Dashboard > Project Settings > API Keys).
# Game tetap bisa dimainkan solo tanpa ini, tetapi leaderboard online dan multiplayer tidak akan aktif.
#
# Cukup SATU dari dua nama kunci di bawah (keduanya diterima):
#   - kunci format baru "sb_publishable_..."  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   - kunci format lama "eyJ..." (anon)        -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# JANGAN pernah memakai kunci "secret" / "service_role" di sini.
NEXT_PUBLIC_SUPABASE_URL=https://kode-proyekmu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_isi_dengan_kuncimu
